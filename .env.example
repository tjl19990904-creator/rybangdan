# ===== 付费排名展示网站 配置示例 =====
# 复制本文件为 .env 并填写真实值后启动： cp .env.example .env

# 服务监听端口
PORT=3000

# 站点名称（展示在榜单页与标题）
SITE_NAME=荣耀榜单

# 货币设置（Stripe 支持的货币代码，如 usd / eur / gbp；CNY 需开通对应账户）
CURRENCY=usd
# 货币符号（仅用于前端展示）
CURRENCY_SYMBOL=$

# 单笔最小上榜金额（主单位，如美元下填 1 表示 $1）
MIN_AMOUNT=1

# 演示模式：当某个支付方式未配置真实密钥时，是否自动直接上榜（true=自动上榜，false=仅显示手动说明）
DEMO_AUTO_PAY=true

# ===== 后台管理员 =====
# 后台登录密码（请务必修改为强密码）
ADMIN_PASSWORD=admin123
# 令牌签名密钥（可选；不填则自动由 ADMIN_PASSWORD 派生）
ADMIN_SECRET=

# ===== 公网地址（用于支付回调 / 成功页跳转）=====
PUBLIC_BASE_URL=http://localhost:3000

# ===== Stripe =====
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Webhook 端点：{PUBLIC_BASE_URL}/api/webhook/stripe（事件：checkout.session.completed）

# ===== PayPal =====
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_SANDBOX=true
# Webhook 端点：{PUBLIC_BASE_URL}/api/webhook/paypal

# ===== Airwallex（空中云汇）=====
AIRWALLEX_CLIENT_ID=
AIRWALLEX_API_KEY=
AIRWALLEX_ACCOUNT_ID=
AIRWALLEX_SANDBOX=true
# Webhook 端点：{PUBLIC_BASE_URL}/api/webhook/airwallex

# ===== USDT / 加密货币 =====
USDT_ADDRESS=                 # 收款地址
USDT_NETWORK=TRC20            # ERC20 / TRC20 / BEP20
USDT_EXPLORER_API_KEY=        # 可选，用于自动核验
USDT_EXPLORER_BASE=

# ===== Wise（银行账户收款）=====
WISE_ACCOUNT_HOLDER=
WISE_ACCOUNT_NUMBER=
WISE_BANK_CODE=
WISE_CURRENCY=

# ===== Payoneer =====
PAYONEER_PAYEE_EMAIL=

# ===== Cash App =====
CASHAPP_CASHTAG=

# ===== 支付宝 =====
ALIPAY_ACCOUNT=
ALIPAY_QR_URL=

# ===== 微信支付 =====
WXPAY_MCH_ID=
WXPAY_APP_ID=
WXPAY_QR_URL=

# ===== 银行卡收款 =====
BANK_NAME=
BANK_ACCOUNT=
BANK_HOLDER=
BANK_SWIFT=

# ===== 数据库 =====
# SQLite 文件路径（默认 data/ranking.db）
DB_PATH=

# 首次启动时是否写入示例榜单数据（true/false）
SEED_DEMO_DATA=true
